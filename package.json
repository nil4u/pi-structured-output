{
  "name": "pi-structured-output",
  "version": "0.2.2",
  "description": "Native structured output for Pi agent sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nil4u/pi-structured-output.git"
  },
  "bugs": {
    "url": "https://github.com/nil4u/pi-structured-output/issues"
  },
  "homepage": "https://github.com/nil4u/pi-structured-output#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e:provider": "npm run build && node scripts/provider-e2e.mjs",
    "test:watch": "vitest",
    "check": "npm run build && npm test",
    "prepublishOnly": "npm run check && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.83.0 <2.0.0",
    "@earendil-works/pi-ai": ">=0.83.0 <2.0.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0 <2.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "jsonrepair": "^3.15.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^24.8.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
